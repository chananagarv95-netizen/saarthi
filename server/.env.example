# ── AI providers ────────────────────────────────────────────────────────────
# Set ANY ONE (or several) of these keys. Configured providers are tried in the
# order below (override with LLM_PROVIDERS); if one fails the next is used.
# With no key at all SAARTHI still runs in offline mode (verified catalog only).

GROQ_API_KEY=            # https://console.groq.com/keys (free tier)
NVIDIA_API_KEY=          # https://build.nvidia.com  (free credits, nvapi-...)
OPENROUTER_API_KEY=      # https://openrouter.ai/keys (has free models)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey (free tier)
OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1   # local models, no key

# Any other OpenAI-compatible endpoint (Together, Fireworks, DeepInfra, vLLM, LM Studio...)
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_API_KEY=
# LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# LLM_VISION_MODEL=

# Optional: provider order and per-provider model overrides
# LLM_PROVIDERS=nvidia,groq,openrouter
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_VISION_MODEL=meta/llama-4-maverick-17b-128e-instruct
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
# LLM_TIMEOUT_MS=45000

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
# Only needed if the frontend is hosted on a different domain:
# CORS_ORIGIN=https://your-frontend.vercel.app
# RATE_LIMIT=150          # requests / 15 min / IP
# DOC_RATE_LIMIT=20       # document uploads / 15 min / IP
